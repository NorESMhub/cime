#!/usr/bin/env python3

"""
This script determines if the required data files for your case exist on local disk in the appropriate subdirectory of
$DIN_LOC_ROOT. It automatically downloads missing data required for your simulation.

It is recommended that users on a given system share a common $DIN_LOC_ROOT directory to avoid duplication on
disk of large amounts of input data. You may need to talk to your system administrator in order to set this up.

This script should be run from $CASEROOT.

To verify the presence of required data use:
   ./check_input_data

To obtain missing datasets from the input data server(s) use:
   ./check_input_data --download
   
On machines with inputdata caching (DIN_CACHE_ROOT variable is set)
Symlinking cache directoriy with din_loc_root can be forced with:
   ./check_input_data --cache-files
   (--download impies this)


This script is automatically called by the case control system, when the case is built and submitted.
So manual usage of this script is optional.
"""
from standard_script_setup import *
from CIME.case import Case

import argparse

###############################################################################
def parse_command_line(args, description):
    ###############################################################################
    parser = argparse.ArgumentParser(
        description=description, formatter_class=argparse.RawTextHelpFormatter
    )

    CIME.utils.setup_standard_logging_options(parser)

    parser.add_argument(
        "--protocol", default=None, help="The input data protocol to download data."
    )

    parser.add_argument(
        "--server",
        default=None,
        help="The input data repository from which to download data.",
    )

    parser.add_argument(
        "-i",
        "--input-data-root",
        default=None,
        help="The root directory where input data goes,\n"
        "use xmlquery DIN_LOC_ROOT to see default value.",
    )

    parser.add_argument(
        "--data-list-dir", default="Buildconf", help="Where to find list of input files"
    )
    
    parser.add_argument(
        "--input-cache-root", default=None,
        help="The root directory where input data cache lives,\n"
        "use xmlquery DIN_CACHE_ROOT to see default value.",
    )

    parser.add_argument(
        "--download",
        action="store_true",
        help="Attempt to download missing input files",
    )

    parser.add_argument(
        "--cache-files",
        action="store_true",
        help="Attempt to get missing input files from cache",
    )

    parser.add_argument(
        "--chksum",
        action="store_true",
        help="chksum inputfiles against inputdata_chksum.dat (if available)",
    )

    args = CIME.utils.parse_args_and_handle_standard_logging_options(args, parser)

    return (
        args.protocol,
        args.server,
        args.input_data_root,
        args.data_list_dir,
        args.input_cache_root,
        args.download,
        args.cache_files,
        args.chksum,
    )


###############################################################################
def _main_func(description):
    ###############################################################################
    (
        protocol,
        address,
        input_data_root,
        data_list_dir,
        input_cache_root,
        download,
        cache_files,
        chksum,
    ) = parse_command_line(sys.argv, description)

    with Case() as case:
        if input_cache_root or not (case.get_value('DIN_CACHE_ROOT') in ('UNSET', None)):
                        # On olivia, we are using special cache directory to manage inputdata.
            # it is populated based on config toml's that are picked up by a hydrator
            # from a specific cdl service on NIRD.
            
            files_cached = case.link_with_cache(
                input_data_root=input_data_root,
                cache_root=input_cache_root,
                data_list_dir=data_list_dir,
                no_cache=(not (download or cache_files)),
                )
            
            if not files_cached:
                sys.exit(0
                    if case.check_all_input_data(
                        protocol=protocol,
                        address=address,
                        input_data_root=input_data_root,
                        data_list_dir=data_list_dir,
                        download=download,
                        chksum=chksum,
                    )
                    else 1
                )
            else:
                sys.exit(0 if files_cached else 1)
        else:
            sys.exit(
                0
                if case.check_all_input_data(
                    protocol=protocol,
                    address=address,
                    input_data_root=input_data_root,
                    data_list_dir=data_list_dir,
                    download=download,
                    chksum=chksum,
                )
                else 1
            )



###############################################################################

if __name__ == "__main__":
    _main_func(__doc__)
